rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'monthlyBudget',
        'onboardingCompleted',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'monthlyBudget',
        'onboardingCompleted',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 80
      && data.monthlyBudget is number
      && data.monthlyBudget >= 0
      && data.monthlyBudget <= 1000000000000
      && data.onboardingCompleted is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidExpenseCategoryId(catId) {
      return catId is string
        && catId.size() <= 32
        && catId in ['alimentacion', 'transporte', 'servicios', 'compras', 'entretenimiento'];
    }

    function isValidMovement(data, movementId) {
      return data.keys().hasAll([
        'id',
        'uid',
        'type',
        'day',
        'isoDate',
        'dateLabel',
        'shortDate',
        'weekday',
        'timeLabel',
        'concept',
        'categoryLabel',
        'amount',
        'clientCreatedAt',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'uid',
        'type',
        'day',
        'isoDate',
        'dateLabel',
        'shortDate',
        'weekday',
        'timeLabel',
        'concept',
        'categoryId',
        'categoryLabel',
        'paymentMethod',
        'amount',
        'notes',
        'clientCreatedAt',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.id)
      && data.id == movementId
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.type is string
      && data.type.size() <= 16
      && data.type in ['expense', 'income']
      && data.day is number
      && data.day >= 1
      && data.day <= 31
      && data.isoDate is string
      && data.isoDate.size() == 10
      && data.isoDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.dateLabel is string
      && data.dateLabel.size() >= 1
      && data.dateLabel.size() <= 32
      && data.shortDate is string
      && data.shortDate.size() >= 1
      && data.shortDate.size() <= 16
      && data.weekday is string
      && data.weekday.size() >= 1
      && data.weekday.size() <= 12
      && data.timeLabel is string
      && data.timeLabel.size() >= 1
      && data.timeLabel.size() <= 24
      && data.concept is string
      && data.concept.size() >= 1
      && data.concept.size() <= 160
      && (!('categoryId' in data) || isValidExpenseCategoryId(data.categoryId))
      && data.categoryLabel is string
      && data.categoryLabel.size() >= 1
      && data.categoryLabel.size() <= 64
      && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 32))
      && data.amount is number
      && data.amount > 0
      && data.amount <= 1000000000000
      && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
      && data.clientCreatedAt is number
      && data.clientCreatedAt >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'displayName', 'onboardingCompleted', 'updatedAt'])
        );

      allow delete: if false;

      match /movements/{movementId} {
        allow get: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId);

        // Secure List Query: evaluates resource.data against request.auth.uid without get()/exists()
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.uid == request.auth.uid;

        // Master Gate: parent UserProfile document must exist
        allow create: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), movementId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), movementId)
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'type',
              'day',
              'isoDate',
              'dateLabel',
              'shortDate',
              'weekday',
              'timeLabel',
              'concept',
              'categoryId',
              'categoryLabel',
              'paymentMethod',
              'amount',
              'notes',
              'updatedAt'
            ])
          );

        allow delete: if isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId);
      }
    }
  }
}
